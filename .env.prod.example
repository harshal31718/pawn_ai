# PAWN — PRODUCTION deploy env (non-secret). Copy to `.env.prod` on the VM.
# Used with: docker compose --env-file .env.prod -f docker-compose.prod.yml ...
# Secrets do NOT go here — they are file-based Docker secrets under ./secrets/.

# Compose project name → isolates volumes/networks from staging (`pawn-dev`).
COMPOSE_PROJECT_NAME=pawn

# Loopback host ports the system Nginx reverse-proxies to (distinct from Enma's
# 5000 and from staging's 8002/3002).
BACKEND_PORT=8001
POSTGREST_PORT=3001

# Same-origin layout: frontend + API both served from the prod domain.
CORS_ORIGINS=https://pawnai.duckdns.org
FRONTEND_URL=https://pawnai.duckdns.org
OAUTH_REDIRECT_URI=https://pawnai.duckdns.org/auth/callback
CSP_CONNECT_SRC=https://pawnai.duckdns.org

# Public HTTPS path Nginx maps to the internal PostgREST (for the Kaggle kernel).
POSTGREST_PUBLIC_URL=https://pawnai.duckdns.org/pgrst

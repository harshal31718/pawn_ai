# secrets — never commit real key files
secrets/*
!secrets/.gitkeep
!secrets/*.example

# local-only deploy backups (real secrets + DB dumps) — never commit
backups/

# SSH keypairs (Oracle instance access, etc.) — never commit
keys/

# data — personal conversation/memory runtime files (registry/ is committed
# data per CLAUDE.md, not runtime state — deliberately NOT ignored)
backend/data/conversations/
backend/data/memory/
backend/data/checkpoints.db
backend/data/checkpoints.db-shm
backend/data/checkpoints.db-wal

# python
__pycache__/
*.py[cod]
.venv/
venv/

# node
node_modules/
dist/
.vite/
.env

# production/staging deploy env files (non-secret URLs, but env-specific; keep
# only the *.example versions in git)
.env.prod
.env.staging

# claude local settings
.claude/settings.local.json

# local-only compose override (e.g. Image Lab tunnel POSTGREST_PUBLIC_URL) --
# keep only docker-compose.override.yml.example in git
docker-compose.override.yml

# os
.DS_Store
Thumbs.db
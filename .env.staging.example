# PAWN — STAGING deploy env (non-secret). Copy to `.env.staging` on the VM.
# Used with: docker compose --env-file .env.staging -f docker-compose.prod.yml ...
# Tracks the `dev` branch. Secrets are file-based under ./secrets/ and are a
# SEPARATE set from prod (esp. encryption_secret / jwt_secret / postgres_password
# — a shared encryption_secret would let one env decrypt the other's BYOK keys).

# PAWN 2.0 Phase E.1: Drive folder ("PAWN-dev/") + Kaggle slug ("-dev" suffix)
# isolation — staging counts as dev, same as local testing, since it can share
# the operator's Google/Kaggle account with prod.
PAWN_ENV=dev

# Distinct project name → its own `pawn-dev_*` volumes/networks.
COMPOSE_PROJECT_NAME=pawn-dev

# Loopback host ports — distinct from prod (8001/3001) and Enma (5000).
BACKEND_PORT=8002
POSTGREST_PORT=3002

# Staging domain.
CORS_ORIGINS=https://dev.pawnai.duckdns.org
FRONTEND_URL=https://dev.pawnai.duckdns.org
OAUTH_REDIRECT_URI=https://dev.pawnai.duckdns.org/auth/callback
CSP_CONNECT_SRC=https://dev.pawnai.duckdns.org

POSTGREST_PUBLIC_URL=https://dev.pawnai.duckdns.org/pgrst
